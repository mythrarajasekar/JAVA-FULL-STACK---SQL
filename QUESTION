CREATE DATABASE INFOSYS;
USE INFOSYS;

CREATE TABLE EMPLOYEE1 (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    salary DECIMAL(10,2),
    department VARCHAR(30)
);

INSERT INTO EMPLOYEE1 VALUES
(1, 'Ravi', 50000, 'IT'),
(2, 'Ravi', 65000, 'HR'),
(3, 'Anu', 45000, 'Finance'),
(4, 'Kiran', 55000, 'IT');

SELECT * FROM EMPLOYEE1;
SET SQL_SAFE_UPDATES = 0;


UPDATE EMPLOYEE1
SET salary = salary + 5000
WHERE name = 'Ravi'
AND salary = 50000
AND department = 'IT';

SELECT * FROM EMPLOYEE1;
